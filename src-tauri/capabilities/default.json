{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "remote-ytm",
  "description": "Разрешает странице music.youtube.com вызывать http_get, Discord Rich Presence и историю прослушиваний",
  "windows": ["main"],
  "remote": {
    "urls": ["https://music.youtube.com/*"]
  },
  "permissions": [
    "core:default",
    "allow-http-get",
    "allow-discord-set-activity",
    "allow-discord-clear-activity",
    "allow-history-start",
    "allow-history-progress",
    "allow-history-delete",
    "allow-history-list",
    "allow-history-top",
    "allow-history-stats"
  ]
}
