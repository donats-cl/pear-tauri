{
  "productName": "Pear",
  "version": "0.1.0",
  "identifier": "com.pear.music",
  "build": {
    "devUrl": "https://music.youtube.com",
    "beforeDevCommand": "pnpm --prefix inject exec vite build",
    "beforeBuildCommand": "pnpm --prefix inject exec vite build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
